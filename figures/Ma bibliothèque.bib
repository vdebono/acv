	file = {ScienceDirect Full Text PDF:C\:\\Users\\victo\\Zotero\\storage\\PBPW52LH\\Zhang et al. - 2019 - Design of 3D printable concrete based on the relat.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\N4UNA2W2\\S0958946519305025.html:text/html},
}

@article{reinhardt_about_2007,
	title = {About the influence of the content and composition of the aggregates on the rheological behaviour of self-compacting concrete},
	volume = {39},
	issn = {1359-5997, 1871-6873},
	url = {http://link.springer.com/10.1617/s11527-006-9102-3},
	doi = {10.1617/s11527-006-9102-3},
	abstract = {Within the scope of a parameter study the inﬂuence of the mixture composition of different selfcompacting concretes on the fresh concrete properties was investigated. For this purpose the standard test methods as well as the fresh concrete rheometer “BTRHEOM” were used. The concrete was modelled as a two-phase system, consisting of the ﬂuid phase paste and the solid phase aggregates. The consistency control parameters paste volume, mortar volume and the coarse aggregate volume could be transferred into the model parameter thickness of excess paste. By means of this model parameter the characteristic values of the standard test methods like slump ﬂow test and V-funnel test as well as the fundamental rheological parameters yield stress and the plastic viscosity could be described. A comparative study showed that the yield stress and the plastic viscosity of self-compacting concrete can be estimated based on the characteristic values of the slump ﬂow test.},
	language = {en},
	number = {7},
	urldate = {2022-11-14},
	journal = {Materials and Structures},
	author = {Reinhardt, Hans W. and Wüstholz, Timo},
	month = aug,
	year = {2007},
	pages = {683--693},
	file = {Reinhardt et Wüstholz - 2007 - About the influence of the content and composition.pdf:C\:\\Users\\victo\\Zotero\\storage\\KCJ2F3XG\\Reinhardt et Wüstholz - 2007 - About the influence of the content and composition.pdf:application/pdf},
}

