	month = dec,
	year = {2011},
	keywords = {A. Hydration, D. Alkali-activated cement, D. Calcium aluminate cement, D. Granulated blast furnace slag, D. Sulfoaluminate},
	pages = {1232--1243},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\victo\\Zotero\\storage\\HMDII6DA\\Juenger et al. - 2011 - Advances in alternative cementitious binders.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\TATHFNAD\\S0008884610002553.html:text/html},
