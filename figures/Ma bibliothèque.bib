@article{motamedi_scaffold-free_2022,
	title = {Scaffold-free {3D} printing of shells: {Introduction} to patching grammar},
	volume = {139},
	issn = {0926-5805},
	shorttitle = {Scaffold-free {3D} printing of shells},
	url = {https://www.sciencedirect.com/science/article/pii/S0926580522001790},
	doi = {10.1016/j.autcon.2022.104306},
	abstract = {This paper describes the Patching technique for building shells without wasteful support, thanks to 3D Printing technology. The method developed in this paper extends ancient vaulting techniques and decodes and formalises them into a design Grammar. Furthermore, numerical tools such as mesh pattern topology and shape topological skeleton are used to adapt vaulting techniques to 3D Printing data. This Grammar classifies the self-standing interconnected components (Patches) and automatically decomposes the non-traditional shapes into those Patches following the Patching process. As a result, the practitioners can use the Patching technique to fabricate low-cost, efficient shells. The presented prototype demonstrates that the Patching technique can contribute to printing shells with low-strength material such as fresh clay without any scaffolding. However, more research needs to be done on the material design and rheology control, shells' cross-section optimisation, and material failure theories such as Mohr-Coulomb and their application to 3D Printing using earth-based material.},
	urldate = {2023-09-18},
	journal = {Automation in Construction},
	author = {Motamedi, Mahan and Mesnil, Romain and Oval, Robin and Baverel, Olivier},
	month = jul,
	year = {2022},
	keywords = {Clay 3D printing, Design grammar, Form-finding, Multi-vaults, Patching method, Robotic additive manufacturing, Scaffold-free 3D printing, Topological design},
	pages = {104306},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\victo\\Zotero\\storage\\4QPQC2DB\\Motamedi et al. - 2022 - Scaffold-free 3D printing of shells Introduction .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\TTP3ZZSL\\S0926580522001790.html:text/html},
}

