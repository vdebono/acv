}

@article{roussel_steady_2010,
	title = {Steady state flow of cement suspensions: {A} micromechanical state of the art},
	volume = {40},
	issn = {0008-8846},
	shorttitle = {Steady state flow of cement suspensions},
	url = {https://www.sciencedirect.com/science/article/pii/S0008884609002385},
	doi = {10.1016/j.cemconres.2009.08.026},
	abstract = {Fresh cementitious pastes can be viewed as suspensions of particles of many different sizes (from several tens of nm to 100μm) in a continuous fluid phase. This broad poly-dispersity implies that various interactions such as surface forces (or colloidal interactions), Brownian forces, hydrodynamic forces or various contact forces between particles interplay. Depending on the volume fraction of the particles in the mixture, the use of admixtures or the magnitude of either the applied stress or strain rate, one or several of these interactions dominate. Our objective here is not to quantitatively predict rheology of cement pastes but rather to understand and classify the situations where, depending on composition and processing, one or other of the physical phenomena will control the macroscopic behavior. The result of this analysis is a conceptual diagram of predominant interactions in flowing cementitious suspensions under simple shear, as a function of shear rate and solid fraction.},
	language = {en},
	number = {1},
	urldate = {2022-11-14},
	journal = {Cement and Concrete Research},
	author = {Roussel, Nicolas and Lemaître, Anael and Flatt, Robert J. and Coussot, Philippe},
	month = jan,
	year = {2010},
	keywords = {Yield stress, Rheology (A), Admixture (D), Particles, Shear thickening},
	pages = {77--84},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\victo\\Zotero\\storage\\RWS6CPQ3\\Roussel et al. - 2010 - Steady state flow of cement suspensions A microme.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\7BANYTGW\\S0008884609002385.html:text/html},
}

@article{wu_effect_2022,
	title = {Effect of aggregate morphology characteristics on the voidage of aggregate loose packing based on {3D} discrete element method},
	volume = {348},
	issn = {0950-0618},
	url = {https://www.sciencedirect.com/science/article/pii/S0950061822022565},
	doi = {10.1016/j.conbuildmat.2022.128598},
	abstract = {Reducing the voidage of aggregate loose packing can improve the workability of concrete, and aggregate morphology directly affects the voidage of aggregate loose packing. This paper combined 3D laser scanning and digital image processing (DIP) technology to perform statistical analysis on aggregate morphology characteristics such as sphericity, flatness, elongation and angularity index. A 3D aggregate database was built using the structured query language (SQL). On this basis, the discrete element model of loose packing was established by the gravity falling method (GFM), considering the natural morphology of aggregates; and the effect of aggregate morphology characteristics on the voidage and void spatial distribution of loose packing under different gradations was quantitatively studied. The results show that the voidage of aggregate loose packing decreases as aggregate sphericity increases and increases with the increase in angularity index. The effect of sphericity on the voidage of aggregate loose packing is about five times that of angularity index. In addition, the voidage in aggregate packing is arranged in Z-shape, and the larger the aggregate sphericity or, the smaller the angularity index, the more uniform the voids in the aggregate packing are distributed.},
	language = {en},
	urldate = {2022-11-14},
	journal = {Construction and Building Materials},
	author = {Wu, Junqing and Zhou, Xiang and Zeng, Xiaohui and Xie, Youjun and Long, Guangcheng and Dong, Rongzhen and Abdullahi Umar, Hussaini and Ma, Gang and Yao, Li},
	month = sep,
	year = {2022},
	keywords = {Aggregate morphology, Database, Digital image processing, Discrete element model, Loose packing voidage},
	pages = {128598},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\victo\\Zotero\\storage\\8YHNT3S6\\Wu et al. - 2022 - Effect of aggregate morphology characteristics on .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\F6YUCRYI\\S0950061822022565.html:text/html},
}

@article{roussel_rheological_2018,
	series = {{SI} : {Digital} concrete 2018},
	title = {Rheological requirements for printable concretes},
	volume = {112},
	issn = {0008-8846},
	url = {https://www.sciencedirect.com/science/article/pii/S000888461830070X},
	doi = {10.1016/j.cemconres.2018.04.005},
	abstract = {We study in this paper the rheological requirements for printable concrete in terms of yield stress, viscosity, elastic modulus, critical strain, and structuration rate. We first discuss the extrusion/deposition process at the level of the nozzle from a material perspective. We then focus on the rheological requirements needed to prevent the flow of one layer or the strength-based failure of the rising printed element. We moreover discuss the rheological requirements needed to control the final geometrical dimensions of one layer and of the entire object, including buckling stability and surface cracking. We finally describe the requirement for a proper intermixing of the layers interface and also note that drying of the upper surface of the layer at rest could also play a major role on the interlayer bond. Finally, we evaluate the effect of the use of printing supports (i.e. non-direct printing) on the above rheological requirements.},
	language = {en},
	urldate = {2022-11-14},
	journal = {Cement and Concrete Research},
	author = {Roussel, Nicolas},
	month = oct,
	year = {2018},
	pages = {76--85},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\victo\\Zotero\\storage\\BIYQENU8\\Roussel - 2018 - Rheological requirements for printable concretes.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\2ER3BXAF\\S000888461830070X.html:text/html},
}

