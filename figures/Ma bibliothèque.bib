@article{archez_strategy_2021,
	title = {Strategy to shape, on a half-meter scale, a geopolymer composite structure by additive manufacturing},
	volume = {5},
	issn = {2666-5395},
	url = {https://www.sciencedirect.com/science/article/pii/S2666539521000171},
	doi = {10.1016/j.oceram.2021.100071},
	abstract = {This work aims at proposing a strategy for 3D-printing geopolymer composite structures at a half-meter scale, without using organic additives. An original printing device based on cartridges is developed and adapted to a 6-axis robot. The yield stress, working time and apparent Young modulus of the extruded material are measured. A devoted software, procedure and printing path are set up, leading to the fabrication of a structure without height limitation, without major geometrical defects or instabilities. The working time ensures the consolidation of the material during printing and good adhesion between layers. As an example, four successive cartridges have been successfully used to elaborate a hollow cylinder (Φ ​= ​35 ​cm, H ​= ​45 ​cm).},
	language = {en},
	urldate = {2022-05-17},
	journal = {Open Ceramics},
	author = {Archez, J. and Maitenaz, S. and Demont, L. and Charrier, M. and Mesnil, R. and Texier-Mandoki, N. and Bourbon, X. and Rossignol, S. and Caron, J. F.},
	month = mar,
	year = {2021},
	keywords = {Additive manufacturing, Composite, Geopolymer, Large scale, Robot, Structure},
	pages = {100071},
	file = {1-s2.0-S2666539521000171-main.pdf:C\:\\Users\\victo\\Zotero\\storage\\EFY5GQQ4\\1-s2.0-S2666539521000171-main.pdf:application/pdf;ScienceDirect Full Text PDF:C\:\\Users\\victo\\Zotero\\storage\\7JTBS6A3\\Archez et al. - 2021 - Strategy to shape, on a half-meter scale, a geopol.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\LKWFEB55\\S2666539521000171.html:text/html},
}

@article{van_den_heever_numerical_2022,
	title = {Numerical modelling strategies for reinforced {3D} concrete printed elements},
	volume = {50},
	issn = {2214-8604},
	url = {https://www.sciencedirect.com/science/article/pii/S2214860421007168},
	doi = {10.1016/j.addma.2021.102569},
	abstract = {Extrusion-based 3D concrete printing (3DCP) prompts a new age of reinforced concrete structures by virtue of the exponential advancements in process, control, material, and fresh-state analysis technologies. Notwithstanding these advancements, latency exists in the numerical analysis of complex geometric forms produced by 3DCP technology. In this research, two finite element (FE) modelling strategies are proposed for the numerical analysis of 3DCP building elements. The objective of these models is to predict the hardened state structural capacity and failure mechanisms of singularly and dually reinforced concrete deep beams under various loading configurations. To validate the proposed FE modelling strategies, the reinforced 3DCP deep beams are experimentally evaluated. An analogy between masonry and 3DCP structures provides premise to the presented FE modelling strategies, and succinct descriptions of the respective modelling strategies, adaptions to the 3DCP design space, and material model prescriptions are provided. Strikingly, the recommended input parameters provide sound agreement with the experimentally evaluated configurations, with all simulations exhibiting a load carry capacity within 14\% of the experimental observations. Not only is the load-displacement response deemed appropriate, but also the numerically produced cracking patterns, placing confidence in the proposed numerical simulation strategies. Furthermore, it is shown that the advent of a 2D plane stress simplification of the fibre-reinforced hollow beam geometry yields adequate agreement while significantly reducing the computational expense required to simulate the nonlinear response of anisotropic printed composites.},
	language = {en},
	urldate = {2022-05-17},
	journal = {Additive Manufacturing},
	author = {van den Heever, Marchant and Bester, Frederick and Kruger, Jacques and van Zijl, Gideon},
	month = feb,
	year = {2022},
	keywords = {Reinforcement, 3D concrete printing, Design and fabrication rules, Finite element analysis, Hardened state mechanical performance, Numerical simulation},
	pages = {102569},
	file = {ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\X9EYEPIM\\S2214860421007168.html:text/html;van den Heever et al. - 2022 - Numerical modelling strategies for reinforced 3D c.pdf:C\:\\Users\\victo\\Zotero\\storage\\WRV4PMXM\\van den Heever et al. - 2022 - Numerical modelling strategies for reinforced 3D c.pdf:application/pdf},
}

@article{ducoulombier_slugs-test_2021,
	title = {The “{Slugs}-test” for extrusion-based additive manufacturing: {Protocol}, analysis and practical limits},
	volume = {121},
	issn = {0958-9465},
	shorttitle = {The “{Slugs}-test” for extrusion-based additive manufacturing},
	url = {https://www.sciencedirect.com/science/article/pii/S0958946521001438},
	doi = {10.1016/j.cemconcomp.2021.104074},
	abstract = {This paper introduces a novel rheological technique allowing for the assessment of printable materials yield stress at nozzle exit in the case of extrusion-based 3D printing. This technique is derived from the analysis of the specific gravity-induced non-Newtonian flow that takes place at nozzle exit, which is at the origin of the formation of material drops or so-called slugs. A simple connected balance located below the nozzle gives access to the slugs mass distribution, the average value and the variability of which allow for the computation of the yield stress and, in parallel, for the assessment of the material homogeneity. In this paper, this method is first experimentally validated on simple materials in simple extruders before it is applied to a real printing system. The equations allowing for the yield stress computation are derived. The accuracy of the technique and its range of applicability are discussed.},
	language = {en},
	urldate = {2022-05-17},
	journal = {Cement and Concrete Composites},
	author = {Ducoulombier, Nicolas and Mesnil, Romain and Carneau, Paul and Demont, Léo and Bessaies-Bey, Hela and Caron, Jean-François and Roussel, Nicolas},
	month = aug,
	year = {2021},
	keywords = {Concrete 3D-printing, Extrusion-based additive manufacturing, Rheological apparatus, Yield stress assessment},
	pages = {104074},
	file = {Ducoulombier et al. - 2021 - The “Slugs-test” for extrusion-based additive manu.pdf:C\:\\Users\\victo\\Zotero\\storage\\NJP2RFI3\\Ducoulombier et al. - 2021 - The “Slugs-test” for extrusion-based additive manu.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\5N6TKKSE\\S0958946521001438.html:text/html},
}

@article{caron_3d_2021,
	title = {{3D} printing of mortar with continuous fibres: {Principle}, properties and potential for application},
	volume = {129},
	issn = {0926-5805},
	shorttitle = {{3D} printing of mortar with continuous fibres},
	url = {https://www.sciencedirect.com/science/article/pii/S0926580521002570},
	doi = {10.1016/j.autcon.2021.103806},
	abstract = {Important developments in additive manufacturing with concrete have been achieved in the past decades. Yet, printed components usually do not comply with building standards or basic reliability principles, and are not commonly used as load-bearing components. A gap between research and practice exists and despite several attempts, off-the-shelf commercial solutions for the reinforcement of the 3D printed structural components seem always expected. This article presents an alternative (pending for patent [1]) for reinforcement of 3D printed structures. This technology inspired by the composite industry is called Flow-Based Pultrusion for additive manufacturing (FBP). A strict control of the rheological behavior of the cementitious matrix ensures the routing and impregnation of continuous rovings of thin fibres (glass, basalt, etc.) without any motorization. The resulting material, Anisotropic Concrete, homogeneously reinforced in a single direction, provides new possibilities, may enhance strength and ductility for hardened material but also help to a better handling of the fresh laces during the deposition, permitting inclined or cantilever paths. This paper describes the process, its constraints, first experimental achievements and first investigations about the mechanical performances of such a material.},
	language = {en},
	urldate = {2022-05-17},
	journal = {Automation in Construction},
	author = {Caron, Jean-François and Demont, Léo and Ducoulombier, Nicolas and Mesnil, Romain},
	month = sep,
	year = {2021},
	keywords = {Additive manufacturing, Anisotropic concrete, Composite materials, Concrete printing, Fiber reinforced concrete, Pultrusion},
	pages = {103806},
	file = {Caron et al. - 2021 - 3D printing of mortar with continuous fibres Prin.pdf:C\:\\Users\\victo\\Zotero\\storage\\H432BE76\\Caron et al. - 2021 - 3D printing of mortar with continuous fibres Prin.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\Z67GQCCL\\S0926580521002570.html:text/html;Version soumise:C\:\\Users\\victo\\Zotero\\storage\\AX58WADC\\Caron et al. - 2021 - 3D printing of mortar with continuous fibres Prin.pdf:application/pdf},
}

@article{gosselin_large-scale_2016,
	title = {Large-scale {3D} printing of ultra-high performance concrete – a new processing route for architects and builders},
	volume = {100},
	issn = {0264-1275},
	url = {https://www.sciencedirect.com/science/article/pii/S0264127516303811},
	doi = {10.1016/j.matdes.2016.03.097},
	abstract = {In the present paper a new additive manufacturing processing route is introduced for ultra-high performance concrete. Interdisciplinary work involving materials science, computation, robotics, architecture and design resulted in the development of an innovative way of 3D printing cementitious materials. The 3D printing process involved is based on a FDM-like technique, in the sense that a material is deposited layer by layer through an extrusion printhead mounted on a 6-axis robotic arm. The mechanical properties of 3D printed materials are assessed. The proposed technology succeeds in solving many of the problems that can be found in the literature. Most notably, this process allows the production of 3D large-scale complex geometries, without the use of temporary supports, as opposed to 2.5D examples found in the literature for concrete 3D printing. Architectural cases of application are used as examples in order to demonstrate the potentialities of the technology. Two structural elements were produced and constitute some of the largest 3D printed concrete parts available until now. Multi-functionality was enabled for both structural elements by taking advantage of the complex geometry which can be achieved using our technology for large-scale additive manufacturing.},
	language = {en},
	urldate = {2022-05-17},
	journal = {Materials \& Design},
	author = {Gosselin, C. and Duballet, R. and Roux, Ph. and Gaudillière, N. and Dirrenberger, J. and Morel, Ph.},
	month = jun,
	year = {2016},
	keywords = {3D Printing, Architecture design, Cementitious materials, Concrete, Large-scale additive manufacturing},
	pages = {102--109},
	file = {1-s2.0-S0264127516303811-main.pdf:C\:\\Users\\victo\\Zotero\\storage\\MURP5CLQ\\1-s2.0-S0264127516303811-main.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\CEG2Z96B\\S0264127516303811.html:text/html;Texte intégral:C\:\\Users\\victo\\Zotero\\storage\\IX65AESZ\\Gosselin et al. - 2016 - Large-scale 3D printing of ultra-high performance .pdf:application/pdf},
}

@article{kuzmenko_environmental_2022,
	title = {Environmental impact of extrusion-based additive manufacturing: generic model, power measurements and influence of printing resolution},
	volume = {157},
	issn = {0008-8846},
	shorttitle = {Environmental impact of extrusion-based additive manufacturing},
	url = {https://www.sciencedirect.com/science/article/pii/S0008884622000989},
	doi = {10.1016/j.cemconres.2022.106807},
	abstract = {We focus in this paper on the embodied and operational contribution to climate change of a concrete-printing robotic cell. We first propose, in the case of extrusion-based additive manufacturing, a simple functional unit that relates a volume-based material impact and a time-based process impact through the printing head velocity and the filament cross section. We then compute, for two robotic arms/bi-component case studies, the embodied impact related to the production of the printing cells themselves and measure their hourly electrical power consumptions. Our results and analysis suggest that the relative contribution to climate change of the printing process alone depends mostly on its spatial resolution. This suggests finally the existence of an optimal printing resolution that may allow for the highest material saving while minimizing the process-related climate change impact.},
	language = {en},
	urldate = {2022-05-17},
	journal = {Cement and Concrete Research},
	author = {Kuzmenko, Kateryna and Ducoulombier, Nicolas and Feraille, Adélaïde and Roussel, Nicolas},
	month = jul,
	year = {2022},
	keywords = {Additive manufacturing, Concrete printing, Climate change, Life cycle analysis, Sustainability},
	pages = {106807},
	file = {Kuzmenko et al. - 2022 - Environmental impact of extrusion-based additive m.pdf:C\:\\Users\\victo\\Zotero\\storage\\TYDJL9KT\\Kuzmenko et al. - 2022 - Environmental impact of extrusion-based additive m.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\HZV8Q6HG\\S0008884622000989.html:text/html},
}

@article{demont_flow-based_2021,
	title = {Flow-based pultrusion of continuous fibers for cement-based composite material and additive manufacturing: rheological and technological requirements},
	volume = {262},
	issn = {0263-8223},
	shorttitle = {Flow-based pultrusion of continuous fibers for cement-based composite material and additive manufacturing},
	url = {https://www.sciencedirect.com/science/article/pii/S0263822321000258},
	doi = {10.1016/j.compstruct.2021.113564},
	abstract = {The vast majority of applications of extrusion-based concrete additive manufacturing deal with unreinforced mortar. The lack of reinforcement is a serious limitation for the industrial development of 3d printed concrete, because of the brittleness and lack of tensile strength of unreinforced mortar. In this paper, a new reinforcement method inspired by pultruded composite manufacturing, called flow-based pultrusion (FBP), is described and used. The principle is that continuous fiber rovings are impregnated and pulled by the matrix flow, avoiding motorisation, and increasing the apparent yield stress of the mortar and consequently its usability. The hardened resulting material, called anisotropic concrete, is unidirectionally and homogenously reinforced. For such composite material, the reinforcement ratio is an important material parameter that relates to specific process variables: roving type, roving count, and output diameter. This article further investigates the effect of the percentage of reinforcement on the process. It also highlights technical requirements to provide the first specifications for flow-based pultrusion.},
	language = {en},
	urldate = {2022-05-17},
	journal = {Composite Structures},
	author = {Demont, Léo and Ducoulombier, Nicolas and Mesnil, Romain and Caron, Jean-François},
	month = apr,
	year = {2021},
	keywords = {Additive manufacturing, Composite materials, Concrete, Pressure drop, Shear transfer, Yield stress},
	pages = {113564},
	file = {Demont et al. - 2021 - Flow-based pultrusion of continuous fibers for cem.pdf:C\:\\Users\\victo\\Zotero\\storage\\SJ8M3472\\Demont et al. - 2021 - Flow-based pultrusion of continuous fibers for cem.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\SSFQX9GU\\S0263822321000258.html:text/html},
}

@article{gribonval_multi-physics_2025,
	title = {Multi-physics modelling of {3D}-printed concrete evolution in environmental conditions},
	volume = {196},
	issn = {0008-8846},
	url = {https://www.sciencedirect.com/science/article/pii/S0008884625001371},
	doi = {10.1016/j.cemconres.2025.107918},
	abstract = {Extrusion-based 3D-printed cementitious structures have high water loss after printing provoking significant plastic shrinkage. In this study, we propose a thermo-poro-mechanical model of printed cementitious materials, driven by the experimental observation of a positive correlation between the printed wall thickness and compressive strength at the hardened state. The model is developed to represent evaporation at free surfaces, water consumption associated to the cement hydration and water flow within the material, accounting for their effect on temperature variations, strains and on the evolution of stiffness and compressive strength. Comparisons of compressive strength and plastic shrinkage with experiments are presented, demonstrating the validity of the proposed model. In the absence of protective measures, wall thickness is positively correlated with compressive strength and negatively correlated with shrinkage. When preventing evaporation by putting printed specimens in water, plastic shrinkage is significantly reduced and the compressive strength is increased, reaching similar values as cast samples.},
	urldate = {2025-05-15},
	journal = {Cement and Concrete Research},
	author = {Gribonval, Alice and Pierre, Maxime and Ducoulombier, Nicolas and Sab, Karam and Mesnil, Romain and Bleyer, Jérémy},
	month = oct,
	year = {2025},
	keywords = {3D concrete printing, Compressive strength, Multi-physics modelling, Plastic shrinkage, Thermo-poro-mechanical model},
	pages = {107918},
	file = {ScienceDirect Snapshot:C\:\\Users\\victo\\Zotero\\storage\\I5QQFGDK\\S0008884625001371.html:text/html},
}

@article{chanvillard_caracterisation_1999,
	title = {Caractérisation des performances d'un béton renforcé de fibres à partir d'un essai de flexion. {Partie} 2: {Identification} d'une loi de comportement intrinsèque en traction},
	volume = {32},
	issn = {1871-6873},
	shorttitle = {Caractérisation des performances d'un béton renforcé de fibres à partir d'un essai de flexion. {Partie} 2},
	url = {https://doi.org/10.1007/BF02480495},
	doi = {10.1007/BF02480495},
	abstract = {Nous avons montré dans la première partie de cette étude que les indices de ténacité n'étaient pas pertinents pour caractériser le comportement des bétons renforcés de fibres. Dans cette seconde partie, nous discutons dans un premier temps de la difficulté à apprécier le comportement d'un béton renforcé de fibre dans une structure sur la base d'un essai de flexion sur un échantillon de taille réduite. La loi de comportement en traction du matériau apparaît alors comme la seule alternative intrinsèque qui permette d'envisager le développement et l'utilisation de méthodes de calcul des structures. Nous montrons dans cette partie qu'il est possible d'extraire une telle loi de traction des fibres à partir des résultats d'un essai de flexion sur prismes entaillés. Cette loi permet alors d'évaluer le potentiel du matériau en terme d'ouverture de fissure critique. Nous discutons ensuite des limites de cette approche notamment en terme de représentativité des prismes par rapport à la structure.},
	language = {fr},
	number = {8},
	urldate = {2025-04-15},
	journal = {Materials and Structures},
	author = {Chanvillard, G.},
	month = oct,
	year = {1999},
	pages = {601--605},
	file = {Full Text PDF:C\:\\Users\\victo\\Zotero\\storage\\T7QFX4W3\\Chanvillard - 1999 - Caractérisation des performances d'un béton renforcé de fibres à partir d'un essai de flexion. Parti.pdf:application/pdf},
}

